# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) Neon connection, used by Prisma for schema changes
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# NextAuth Authentication
AUTH_SECRET="generate-a-long-random-32-character-secret"
ADMIN_EMAIL="admin@crestyve.com"
ADMIN_PASSWORD="change-me-in-production"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary (Media upload)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Razorpay (Payments)
RAZORPAY_KEY_ID=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Resend (Email Notifications)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Crestyve <orders@yourdomain.com>"
EMAIL_FROM="Crestyve <orders@yourdomain.com>"

