# Database (Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth
AUTH_SECRET="generate-a-long-random-string"
ADMIN_EMAIL="admin@crestyve.com"
ADMIN_PASSWORD="change-me"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary (existing)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Razorpay (checkout + webhook)
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Configure this URL as a webhook endpoint in the Razorpay dashboard:
# https://<your-domain>/api/webhooks/razorpay  (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=""

# Resend (optional order confirmation emails)
# If unset, order confirmation emails are skipped (checkout still works).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Crestyve <orders@yourdomain.com>"
